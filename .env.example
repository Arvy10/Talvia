DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BREVO_API_KEY=
EMAIL_FROM_NAME=Talvia
EMAIL_FROM_ADDRESS=verified-sender@example.com

# Opt-in acquisition e-mail through Resend. These values are server-only and
# are separate from the Brevo sender above, which continues to send auth mail.
RESEND_API_KEY=
RESEND_EMAIL_FROM=Talvia <verified-sender@example.com>
RESEND_EMAIL_REPLY_TO=
APP_URL=http://localhost:3000
ACQUISITION_SCHEDULER_SECRET=
RESEND_WEBHOOK_SECRET=
ACQUISITION_UNSUBSCRIBE_SECRET=

# Optional: enables AI-powered Business Context analysis (website -> structured
# profile). Without any key set, the feature returns a clean "unavailable"
# state instead of failing. Set ONE of GEMINI_API_KEY or ANTHROPIC_API_KEY —
# if both are set, GEMINI_API_KEY wins unless AI_PROVIDER forces a choice.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini | anthropic  (optional override, only needed if both keys are set)
# BUSINESS_ANALYZER_MODEL=  (optional override; defaults to gemini-3.7-flash or claude-haiku-4-5)

# Optional: enables real LinkedIn/WhatsApp/Gmail connections via Unipile
# (ARCHITECTURE.md §3). Without these, /api/connections/[channel]/connect and
# /api/webhooks/unipile return a clean "not configured" response instead of
# failing. UNIPILE_API_URL is the account-specific base URL Unipile assigns
# (e.g. https://apiXXX.unipile.com:XXX). UNIPILE_WEBHOOK_SECRET is a secret you
# choose yourself and configure as the "Unipile-Auth" header on the webhook
# subscription in the Unipile dashboard.
UNIPILE_API_KEY=
UNIPILE_API_URL=
UNIPILE_WEBHOOK_SECRET=

# Campaign execution engine: POST /api/campaigns/engine/run with header
# "Authorization: Bearer <CAMPAIGN_ENGINE_SECRET>" must be hit periodically
# by an external scheduler (Hostinger cron job, GitHub Actions scheduled
# workflow, etc.) — Talvia does not run its own background loop. Without
# this configured, campaigns are only executed when a user manually clicks
# "Envoyer ce lot" in the UI (same underlying engine call, just triggered
# by hand instead of on a schedule).
CAMPAIGN_ENGINE_SECRET=
# Optional: Talvia's own daily invitation ceiling per workspace (not a
# LinkedIn-provided limit — a conservative default of Talvia's choosing).
# LINKEDIN_DAILY_INVITE_LIMIT=20
